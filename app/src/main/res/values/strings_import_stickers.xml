<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ==== The "open with" dialog: a keyboard file opened from a file
         manager, a chat app or a downloads notification. ==== -->

    <string name="import_progress_reading">Reading file…</string>
    <string name="import_progress_importing">Importing…</string>
    <!-- Above the list of lines that say what the app had to change to make the
         file usable. -->
    <string name="import_repairs_title">The app changed these items during the import:</string>

    <!-- ==== Theme and layout files. ==== -->

    <!-- Title of the confirm dialog. %1$s is the name inside the file, for
         example a theme name or a layout name. -->
    <string name="import_name_title">Import %1$s?</string>
    <!-- %1$s is the name of the theme or the layout that the app imported. -->
    <string name="import_done_name">The app imported %1$s.</string>
    <!-- Stands in for the name when a theme file gives no name. It goes into
         import_name_title ("Import the theme?") and import_done_name. -->
    <string name="import_theme_fallback_name">the theme</string>
    <string name="import_theme_body">The app adds the theme to your themes and uses it on the keyboard.</string>
    <!-- Languages is the name of a screen in the settings app. -->
    <string name="import_layout_body">The app adds the layout to your layouts. The layout stays off. To type with it, turn it on in Languages.</string>

    <!-- ==== Backup files. ==== -->

    <string name="import_backup_title">Import backup?</string>
    <string name="import_backup_contains">The file has these items:</string>
    <!-- One line per part of the backup. %1$s is the name of the part, for
         example "Themes". %2$s is how much of it the file holds, for example
         "3 custom themes". -->
    <string name="import_backup_section_line">• %1$s: %2$s</string>
    <string name="import_backup_merge_note">The app merges the settings into your current settings. The dictionary, the clipboard and the snippets replace the ones on your device.</string>
    <!-- Shown for a backup file that carries the keys for the network tools. -->
    <string name="import_api_keys_note">The file has API keys. They replace the keys that you set here.</string>
    <!-- %1$s is a list of the parts that the app restored, for example
         "themes, snippets". -->
    <string name="import_backup_restored">The app restored %1$s.</string>
    <string name="import_backup_nothing">The file has nothing to restore.</string>
    <string name="import_backup_settings_failed">The app could not apply the settings. Your settings did not change.</string>
    <string name="import_not_a_backup">That file is not a WM Keyboard backup.</string>

    <!-- ==== The older settings-only backup file. ==== -->

    <string name="import_settings_title">Import settings?</string>
    <!-- %1$d is how many settings the file holds. -->
    <plurals name="import_settings_overwrite">
        <item quantity="one">The app replaces %1$d setting with the value from that file.</item>
        <item quantity="other">The app replaces %1$d settings with the values from that file.</item>
    </plurals>
    <!-- %1$d is how many entries in the file the app cannot read. -->
    <plurals name="import_settings_skipped">
        <item quantity="one">The app cannot read %1$d entry. The app skips it.</item>
        <item quantity="other">The app cannot read %1$d entries. The app skips them.</item>
    </plurals>
    <!-- %1$d is how many settings the app restored. -->
    <plurals name="import_settings_restored">
        <item quantity="one">The app restored %1$d setting.</item>
        <item quantity="other">The app restored %1$d settings.</item>
    </plurals>
    <string name="import_settings_rolled_back">The app could not apply that backup. Your settings did not change.</string>
    <string name="import_not_a_settings_backup">That file is not a WM Keyboard settings backup.</string>

    <!-- ==== Snippet files. ==== -->

    <!-- %1$d is how many snippets the file holds. -->
    <plurals name="import_snippets_title">
        <item quantity="one">Import %1$d snippet?</item>
        <item quantity="other">Import %1$d snippets?</item>
    </plurals>
    <string name="import_snippets_body">The app adds them to the snippets that you have. The app replaces nothing.</string>
    <!-- %1$d is how many snippets the app imported. -->
    <plurals name="import_snippets_done">
        <item quantity="one">The app imported %1$d snippet.</item>
        <item quantity="other">The app imported %1$d snippets.</item>
    </plurals>

    <!-- ==== Sticker pack files. ==== -->

    <string name="import_stickers_title">Import sticker pack?</string>
    <string name="import_stickers_body">The app adds the pack to your own stickers. The app copies the images to your device.</string>
    <!-- %1$s is the name of the pack. %2$d is how many stickers it holds. -->
    <plurals name="import_stickers_done">
        <item quantity="one">The app imported %1$s with %2$d sticker.</item>
        <item quantity="other">The app imported %1$s with %2$d stickers.</item>
    </plurals>
    <string name="import_not_a_sticker_pack">That file is not a WM Keyboard sticker pack.</string>
    <string name="import_stickers_none_read">The app cannot read any sticker in that pack.</string>
    <!-- %1$d is the largest number of sticker packs that the app keeps. -->
    <plurals name="import_stickers_too_many">
        <item quantity="one">You already have %1$d sticker pack. Delete it first.</item>
        <item quantity="other">You already have %1$d sticker packs. Delete one first.</item>
    </plurals>
    <string name="import_file_unreadable">The app cannot read that file.</string>

    <!-- ==== Icon pack files. ==== -->

    <string name="import_icons_title">Import icon pack?</string>
    <string name="import_icons_body">The app installs the pack and turns it on. Its icons replace the built-in icons. The app keeps the icons that you set.</string>

    <!-- ==== A file the keyboard does not know, or cannot open. ==== -->

    <string name="import_unrecognized_title">Not a WM Keyboard file</string>
    <string name="import_unrecognized_body">The keyboard cannot read that file. It is not a theme, a layout, a snippet pack, a sticker pack, an icon pack, a plugin or a backup.</string>
    <string name="import_unreadable_title">The app cannot open that file</string>
    <string name="import_unreadable_body">The file is not available. Something moved or deleted it, or the app that shared it stopped access to it.</string>

    <!-- ==== Plugin files. The dialog says what the plugin is and what it can
         do before it offers to install it. ==== -->

    <string name="import_plugin_off_title">Plugins are turned off</string>
    <!-- Settings &gt; Tools &gt; Plugins is the path to the screen that turns
         plugins on. -->
    <string name="import_plugin_off_body">First turn plugins on in Settings &gt; Tools &gt; Plugins. Plugins stay off until you ask for them, so nothing installs or runs unexpectedly.</string>
    <!-- Title of the confirm dialog. %1$s is the name that the plugin gives
         itself. The quotation marks keep that name apart from the sentence. -->
    <string name="import_plugin_install_title">Install “%1$s”?</string>
    <!-- Stands in for the description when the plugin gives none. -->
    <string name="import_plugin_default_description">A WM Keyboard plugin.</string>
    <!-- %1$s is the version of the plugin, for example "1.2". -->
    <string name="import_plugin_version">Version %1$s</string>
    <!-- %1$s is the version of the plugin. %2$s is the name of its author. -->
    <string name="import_plugin_version_by_author">Version %1$s by %2$s</string>
    <string name="import_plugin_permissions_intro">The plugin can:</string>
    <string name="import_plugin_no_permissions">The plugin asks for nothing more than its own panel.</string>
    <string name="import_plugin_sandbox_note">Plugins run in a sandbox. This plugin cannot see what you type, read your clipboard or use the internet.</string>
    <!-- Plugins is the name of the tool that opens an installed plugin.
         %1$s is the name of the plugin. -->
    <string name="import_plugin_installed">The app installed %1$s. Open it from the Plugins tool.</string>
    <!-- Plugins is the name of the tool that opens an installed plugin.
         %1$s is the name of the plugin. -->
    <string name="import_plugin_updated">The app updated %1$s. Open it from the Plugins tool.</string>
    <string name="import_plugin_rejected_title">The app cannot install that plugin</string>
    <string name="import_not_a_plugin">That file is not a WM Keyboard plugin.</string>
    <!-- %1$d is the largest number of plugins that the app keeps. -->
    <plurals name="import_plugin_too_many">
        <item quantity="one">You already have %1$d plugin. Delete it first.</item>
        <item quantity="other">You already have %1$d plugins. Delete one first.</item>
    </plurals>
    <string name="import_plugin_failed">The app could not install that plugin.</string>

    <!-- ==== Sticker packs screen: the packs the user owns. ==== -->

    <!-- 512×512 WebP is an image format and a size in pixels. My stickers is
         the name of a tab in the sticker tool of the keyboard. -->
    <string name="import_stickers_caption">These are your own stickers. You send them from the “My stickers” tab of the sticker tool. The app changes still images to 512×512 WebP files, so WhatsApp gets them as real stickers. The app keeps animated GIF files as they are, and sends them as images.</string>
    <string name="import_sticker_packs_section_title">Your packs</string>
    <string name="import_sticker_packs_empty_title">No sticker packs yet</string>
    <string name="import_sticker_packs_empty_subtitle">Make a pack below, or import a pack that someone shared</string>
    <string name="import_sticker_pack_new_title">New pack</string>
    <string name="import_sticker_pack_new_subtitle">Then add stickers from your photos</string>
    <string name="import_sticker_pack_import_title">Import a pack</string>
    <!-- .wmstickers is a file extension. Keep it as it is. -->
    <string name="import_sticker_pack_import_subtitle">Opens a .wmstickers file that someone shared</string>
    <!-- %1$s is the name of the pack. -->
    <string name="import_sticker_pack_export_desc">Export %1$s</string>
    <!-- %1$s is the name of the pack. -->
    <string name="import_sticker_pack_delete_desc">Delete %1$s</string>
    <!-- %1$d is how many stickers the pack holds. -->
    <plurals name="import_sticker_count">
        <item quantity="one">%1$d sticker</item>
        <item quantity="other">%1$d stickers</item>
    </plurals>
    <string name="import_sticker_pack_empty_label">Empty</string>
    <!-- %1$s is the name of the pack. -->
    <string name="import_sticker_pack_saved">The app saved %1$s.</string>
    <string name="import_sticker_pack_write_error">The app cannot write that file.</string>
    <!-- %1$d is how many more lines the app does not show. -->
    <plurals name="import_repairs_more">
        <item quantity="one">…and %1$d more</item>
        <item quantity="other">…and %1$d more</item>
    </plurals>
    <!-- %1$d is the largest number of sticker packs that the app keeps. -->
    <plurals name="import_sticker_packs_full">
        <item quantity="one">You already have %1$d sticker pack.</item>
        <item quantity="other">You already have %1$d sticker packs.</item>
    </plurals>
    <!-- %1$s is the name of the pack. -->
    <string name="import_sticker_pack_delete_title">Delete %1$s?</string>
    <!-- %1$d is how many stickers the pack holds. -->
    <plurals name="import_sticker_pack_delete_body">
        <item quantity="one">The app deletes its %1$d sticker from your device. To keep a copy, export the pack first.</item>
        <item quantity="other">The app deletes its %1$d stickers from your device. To keep a copy, export the pack first.</item>
    </plurals>

    <!-- ==== One sticker pack: rename it, and add or edit its stickers. ==== -->

    <!-- 512×512 WebP is an image format and a size in pixels. -->
    <string name="import_sticker_pack_caption">The app changes still images to 512×512 WebP files below 100 KB. This is the sticker format that WhatsApp asks for. The app keeps animated GIF files as they are, because Android cannot write animated WebP. Those files always send as images.</string>
    <string name="import_sticker_pack_section_title">Pack</string>
    <string name="import_sticker_pack_rename_subtitle">Press to rename</string>
    <string name="import_sticker_pack_rename_title">Rename pack</string>
    <string name="import_stickers_add_title">Add stickers</string>
    <string name="import_stickers_adding_title">Adding…</string>
    <!-- %1$d is how many stickers the pack holds. %2$d is how many it can
         hold. "of" follows the first number, not the counted noun, so the
         wording never changes with the count: this is a ratio, not a plural. -->
    <string name="import_stickers_used_subtitle" tools:ignore="PluralsCandidate">%1$d of %2$d used</string>
    <string name="import_stickers_empty_title">No stickers in this pack</string>
    <!-- Klipy and GIPHY are the names of two sticker services. -->
    <string name="import_stickers_empty_subtitle">Add stickers from your photos, or press and hold a Klipy or GIPHY sticker in the keyboard</string>
    <!-- Read out for a sticker that has no name of its own. -->
    <string name="import_sticker_desc_fallback">Sticker</string>
    <string name="import_sticker_pack_missing">The app cannot find this pack.</string>
    <string name="import_sticker_pack_full">That pack is full.</string>

    <!-- ==== What came of adding photos to a pack. The app puts these
         sentences one after the other in the same message. ==== -->

    <!-- %1$d is how many stickers the app added. -->
    <plurals name="import_stickers_added">
        <item quantity="one">The app added %1$d sticker.</item>
        <item quantity="other">The app added %1$d stickers.</item>
    </plurals>
    <string name="import_stickers_none_added">The app added nothing.</string>
    <!-- %1$d is how many photos were too large. 2 MB is a file size. -->
    <plurals name="import_stickers_too_large">
        <item quantity="one">%1$d file is too large. An animated file must be 2 MB or less.</item>
        <item quantity="other">%1$d files are too large. An animated file must be 2 MB or less.</item>
    </plurals>
    <!-- %1$d is how many photos the app cannot read. -->
    <plurals name="import_stickers_unreadable">
        <item quantity="one">The app cannot read %1$d file as an image.</item>
        <item quantity="other">The app cannot read %1$d files as an image.</item>
    </plurals>
    <string name="import_sticker_pack_now_full">The pack is now full.</string>

    <!-- ==== The dialogs that name a pack and edit one sticker. ==== -->

    <string name="import_sticker_edit_title">Edit sticker</string>
    <string name="import_name_label">Name</string>
    <string name="import_sticker_emoji_tags_label">Emoji tags</string>
    <string name="import_sticker_emoji_tags_hint">The app searches these with the name, for example 😂 🐱</string>
    <string name="import_sticker_move_up">Move up</string>
    <string name="import_sticker_move_down">Move down</string>
    <string name="import_sticker_move_pack">Move to another pack</string>
    <string name="import_sticker_delete_action">Delete this sticker</string>

</resources>
