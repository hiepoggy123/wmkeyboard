<?xml version="1.0" encoding="utf-8"?>
<!--
    The text-editing panel's own layout editor: Settings / Tools / Text editing /
    Panel layout. The action names are the keys of that panel.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="textedit_layout_title">Panel layout</string>
    <string name="textedit_layout_subtitle">Arrange the keys of the text editing panel</string>
    <string name="textedit_layout_value_default">Standard</string>
    <string name="textedit_layout_value_custom">Your own</string>
    <string name="textedit_layout_intro_body">Press a key in the preview to change what it does, how wide it is, and how many rows it covers. Keys that do not repeat can also do a second action when you press and hold them. The keyboard uses your changes at once.</string>

    <!-- %1$d is the row number, counted from the top. -->
    <string name="textedit_layout_row_title">Row <xliff:g id="row" example="1">%1$d</xliff:g></string>
    <!-- %1$.2f is a height multiplier, for example 1.25. -->
    <string name="textedit_layout_row_height_label">Row height ×<xliff:g id="multiplier" example="1.25">%1$.2f</xliff:g></string>
    <string name="textedit_layout_add_key_action">Add a key</string>
    <string name="textedit_layout_delete_row_action">Delete the row</string>
    <string name="textedit_layout_add_row_action">Add a row</string>
    <string name="textedit_layout_delete_key_action">Delete the key</string>
    <string name="textedit_layout_move_left_desc">Move left</string>
    <string name="textedit_layout_move_right_desc">Move right</string>

    <!-- %1$d is the row number, %2$d the position in that row. -->
    <string name="textedit_layout_key_position_title">Row <xliff:g id="row" example="1">%1$d</xliff:g>, key <xliff:g id="key" example="2">%2$d</xliff:g></string>
    <string name="textedit_layout_key_action_title">What the key does</string>
    <string name="textedit_layout_key_hold_title">Press and hold</string>
    <string name="textedit_layout_key_hold_subtitle">A second action for this key</string>
    <!-- %1$.2f is a width in grid units, for example 1.40. -->
    <string name="textedit_layout_key_width_label">Width <xliff:g id="width" example="1.40">%1$.2f</xliff:g></string>
    <!-- %1$d is a number of rows. -->
    <string name="textedit_layout_key_span_label">Covers <xliff:g id="rows" example="3">%1$d</xliff:g> rows</string>
    <string name="textedit_layout_hold_repeats_body">This key repeats while you hold it, so it cannot do a second action.</string>
    <!-- Small note under a key in the preview. %1$s is an action name, for example "Select all". -->
    <string name="textedit_layout_hold_badge">Hold: <xliff:g id="action" example="Select all">%1$s</xliff:g></string>

    <string name="textedit_layout_reset_title">Use the standard layout?</string>
    <string name="textedit_layout_reset_body">The panel goes back to the layout the app ships with. Your arrangement is deleted.</string>

    <!-- Names of the panel keys, in the picker and in the preview. -->
    <string name="textedit_action_left">Left</string>
    <string name="textedit_action_right">Right</string>
    <string name="textedit_action_up">Up</string>
    <string name="textedit_action_down">Down</string>
    <string name="textedit_action_word_left">Word left</string>
    <string name="textedit_action_word_right">Word right</string>
    <string name="textedit_action_page_up">Start of the text</string>
    <string name="textedit_action_page_down">End of the text</string>
    <string name="textedit_action_home">Start of the line</string>
    <string name="textedit_action_end">End of the line</string>
    <string name="textedit_action_select">Select</string>
    <string name="textedit_action_select_all">Select all</string>
    <string name="textedit_action_select_word">Select the word</string>
    <string name="textedit_action_select_line">Select the line</string>
    <string name="textedit_action_copy">Copy</string>
    <string name="textedit_action_paste">Paste</string>
    <string name="textedit_action_backspace">Delete</string>
</resources>
