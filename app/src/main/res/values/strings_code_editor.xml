<?xml version="1.0" encoding="utf-8"?>
<!--
  The code editor that the "Edit as JSON" screens draw. The words here belong to
  the editor itself, not to layouts, so a second screen that edits code can use
  the same file.
-->
<resources>

    <!-- Content description of the redo button. Undo, copy and paste use the common words. -->
    <string name="code_redo_desc">Redo</string>
    <!-- Content description of the button that indents the text again. -->
    <string name="code_format_desc">Format the text</string>
    <!-- Content description of the wrap button while long lines run off the screen. -->
    <string name="code_wrap_on_desc">Wrap long lines</string>
    <!-- Content description of the wrap button while long lines wrap. -->
    <string name="code_wrap_off_desc">Do not wrap long lines</string>

    <!-- Where the caret is. %1$d is the line number, %2$d the column number. -->
    <string name="code_position_label">Line %1$d, column %2$d</string>
    <!-- How long the text is. %1$d is the number of characters. -->
    <plurals name="code_character_count">
        <item quantity="one">%1$d character</item>
        <item quantity="other">%1$d characters</item>
    </plurals>
    <!-- Shown while the text parses. -->
    <string name="code_status_ok">No problems</string>
    <!-- Shown while the text does not parse. %1$d is the line number. Press it to go there. -->
    <string name="code_status_problem">Problem on line %1$d</string>

    <!-- Placeholder of the find field. -->
    <string name="code_find_label">Find</string>
    <!-- Placeholder of the replace field. -->
    <string name="code_replace_label">Replace with</string>
    <!-- Which result is showing. %1$d is its number, %2$d how many results there are. -->
    <string name="code_find_count">%1$d of %2$d</string>
    <string name="code_find_none">No results</string>
    <string name="code_find_invalid">The pattern is not valid</string>
    <!-- Content descriptions of the three search options, which are drawn as Aa, ab and .* -->
    <string name="code_find_case_desc">Match case</string>
    <string name="code_find_word_desc">Whole words only</string>
    <string name="code_find_regex_desc">Use a regular expression</string>
    <string name="code_find_previous_desc">Previous result</string>
    <string name="code_find_next_desc">Next result</string>
    <string name="code_find_close_desc">Close find</string>
    <!-- A chip that shows the replace field under the find field. -->
    <string name="code_replace_toggle">Replace</string>
    <!-- A button that replaces the result that is showing. -->
    <string name="code_replace_one">Replace</string>
    <string name="code_replace_all">Replace all</string>
    <string name="code_go_to_line_title">Go to line</string>
    <string name="code_go_to_line_label">Line number</string>
    <!-- %1$d is the number of the last line. -->
    <string name="code_go_to_line_error">Enter a line from 1 to %1$d</string>
    <!-- The button that goes to the line typed. -->
    <string name="code_go_to_line_action">Go</string>

</resources>
