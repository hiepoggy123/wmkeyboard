    <!-- Themes screen: the light/dark mode of the settings app and of the
         Default theme. -->
    <!-- The name of the theme that follows the system colours. Shown in the
         theme gallery and in every theme picker. -->
    <string name="theme_default_name">Default (system)</string>
    <string name="theme_mode_section_title">Mode</string>
    <string name="theme_mode_section_body">This applies to the settings app and to the Default theme.</string>
    <string name="theme_mode_system_label">System</string>
    <string name="theme_mode_light_label">Light</string>
    <string name="theme_mode_dark_label">Dark</string>
    <!-- Names a screen technology. Keep the capital letters. -->
    <string name="theme_mode_amoled_label">AMOLED</string>
    <string name="theme_material_you_title">Material You colors</string>
    <string name="theme_material_you_subtitle">The Default theme takes its colors from your wallpaper</string>

    <!-- Themes screen: the automatic light and dark pair. -->
    <string name="theme_auto_section_title">Auto (light and dark)</string>
    <string name="theme_auto_section_body">The keyboard changes between a light theme and a dark theme on its own. While this is on, the theme tool on the keyboard shows only a preview. The schedule selects the active theme.</string>
    <string name="theme_auto_title">Auto theme</string>
    <string name="theme_auto_subtitle">Use a light theme in the day and a dark theme at night</string>
    <string name="theme_auto_light_title">Light theme</string>
    <string name="theme_auto_dark_title">Dark theme</string>
    <string name="theme_auto_trigger_system_body">The keyboard follows the light and dark setting of your device. This includes any schedule that Android runs for it.</string>
    <string name="theme_auto_light_from_title">Light theme from</string>
    <string name="theme_auto_dark_from_title">Dark theme from</string>
    <!-- %1$s is the name of the saved place, for example "Berlin". When no
         place name is saved it is theme_auto_trigger_sun_place_fallback. -->
    <string name="theme_auto_trigger_sun_body">The light theme shows between sunrise and sunset at <xliff:g id="place" example="Berlin">%1$s</xliff:g>. Your device calculates the times without a network connection.</string>
    <!-- Goes into theme_auto_trigger_sun_body when the saved place has no name. -->
    <string name="theme_auto_trigger_sun_place_fallback">your saved location</string>
    <string name="theme_auto_trigger_sun_no_location_body">No location is saved yet. Set one in the settings of the weather tool. Until then the keyboard uses the light and dark setting of your device.</string>
    <!-- Button that accepts the time on the clock face. -->
    <string name="theme_time_set_action">Set</string>

    <!-- Theme pickers. -->
    <string name="theme_mode_picker_title">Theme for this mode</string>
