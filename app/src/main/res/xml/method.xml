<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.wasimaster.wmkeyboard.app.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <!--
      No static subtypes on purpose. Every subtype we expose is registered at
      runtime, one per enabled layout (WMKeyboardService.registerSubtypes), and
      only while the "list languages in the Android switcher" setting is on.

      A static one used to sit here as a bootstrap entry. The system implicitly
      enables it whenever nothing else is enabled, and the input-method picker
      draws the subtype label where the other keyboards show their own name — so
      with the setting off the keyboard was listed as "English" while everything
      else was listed by name. With no static subtype the picker has no label to
      draw and falls back to the IME label, @string/ime_name.
    -->
</input-method>
