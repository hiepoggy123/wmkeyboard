{
  "format": "wmkeyboard-layout",
  "version": 1,
  "layout": {
    "id": "asset_sms_qwerty",
    "name": "Sääʹmkiõll (Skolt Sami)",
    "langId": "sms",
    "version": 1,
    "layers": {
      "letters": {
        "rows": [
          [
            { "label": "q" },
            { "label": "w" },
            { "label": "e", "longPress": ["ë"] },
            { "label": "r" },
            { "label": "t" },
            { "label": "y" },
            { "label": "u" },
            { "label": "i" },
            { "label": "o", "longPress": ["õ", "ö"] },
            { "label": "p" }
          ],
          [
            { "label": "a", "longPress": ["â", "ä", "å", "á"] },
            { "label": "s", "longPress": ["š"] },
            { "label": "d", "longPress": ["đ", "ǥ", "ǧ", "ǩ"] },
            { "label": "f" },
            { "label": "g" },
            { "label": "h" },
            { "label": "j" },
            { "label": "k" },
            { "label": "l" }
          ],
          [
            { "label": "⇧", "action": { "type": "shift" }, "width": 1.5 },
            { "label": "z", "longPress": ["ž"] },
            { "label": "x" },
            { "label": "c", "longPress": ["č", "ʒ", "ǯ"] },
            { "label": "v" },
            { "label": "b" },
            { "label": "n", "longPress": ["ŋ"] },
            { "label": "m" },
            { "label": "⌫", "action": { "type": "delete" }, "width": 1.5 }
          ],
          [
            { "label": "?123", "action": { "type": "symbols" }, "width": 1.5 },
            { "label": ",", "longPress": ["!", "?"], "role": "Comma" },
            { "label": "🌐", "action": { "type": "language_switch" } },
            { "label": " ", "action": { "type": "space" }, "width": 4 },
            { "label": ".", "longPress": ["…", ",", "?", "!", ":", ";"], "role": "Period" },
            { "label": "⏎", "action": { "type": "enter" }, "width": 1.5 }
          ]
        ]
      }
    }
  }
}
