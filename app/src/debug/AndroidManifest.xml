<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
             Screenshot harness for the documentation. Debug builds only;
             started from adb, never from the launcher. exported so
             `adb shell am start` can reach it without root.
        -->
        <activity
            android:name="com.wasimaster.wmkeyboard.app.DocsShotActivity"
            android:exported="true"
            android:theme="@style/Theme.WMKeyboard"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
