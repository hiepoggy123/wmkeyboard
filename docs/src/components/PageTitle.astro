---
/**
 * Page heading with a breadcrumb trail above it.
 *
 * The crumbs are built from Starlight's sidebar rather than from the URL, which
 * is what astro-breadcrumbs would do on its own. Two reasons: the sidebar knows
 * each page's real title (so we get "Keys & typing basics", not "Basics"), and
 * none of our section directories have an index page — a URL-derived trail would
 * link every middle crumb to a 404. Section crumbs point at the first page in
 * that section instead.
 *
 * starlight-theme-black also overrides `PageTitle` (its version carries the
 * markdown actions and the prev/next buttons), and it steps aside whenever we
 * claim a component first. So we render its override here rather than replacing
 * it — the <h1 id="_top"> and the page description come from there.
 */
import { Icon } from '@astrojs/starlight/components';
import { Breadcrumbs } from 'astro-breadcrumbs';
import 'astro-breadcrumbs/breadcrumbs.css';
import ThemeBlackPageTitle from 'starlight-theme-black/overrides/PageTitle.astro';

import { SITE_TITLE } from '../site.mjs';

type SidebarEntry = (typeof Astro.locals.starlightRoute.sidebar)[number];
type SidebarGroup = Extract<SidebarEntry, { type: 'group' }>;

const { entry, sidebar } = Astro.locals.starlightRoute;

/** First actual page inside a group — where that group's crumb points. */
function firstLink(entries: SidebarEntry[]): string | undefined {
	for (const item of entries) {
		if (item.type === 'link') return item.href;
		const nested = firstLink(item.entries);
		if (nested) return nested;
	}
	return undefined;
}

/** The chain of groups wrapping the page Starlight flagged as current. */
function groupTrail(
	entries: SidebarEntry[],
	ancestors: SidebarGroup[] = []
): SidebarGroup[] | undefined {
	for (const item of entries) {
		if (item.type === 'link') {
			if (item.isCurrent) return ancestors;
		} else {
			const found = groupTrail(item.entries, [...ancestors, item]);
			if (found) return found;
		}
	}
	return undefined;
}

/**
 * Groups autogenerated from a directory take the directory name verbatim, so
 * `reference/settings` arrives as "settings". Labels written out in the sidebar
 * config ("Getting started") are already cased and pass through untouched.
 */
const label = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);

const crumbs = [
	{ text: SITE_TITLE, href: '/' },
	...(groupTrail(sidebar) ?? []).flatMap((group) => {
		const href = firstLink(group.entries);
		return href ? [{ text: label(group.label), href }] : [];
	}),
	// No aria-current here — <Breadcrumbs> marks the last crumb itself.
	{ text: entry.data.title, href: Astro.url.pathname },
];
---

<Breadcrumbs crumbs={crumbs} ariaLabel="Breadcrumb" id="breadcrumbs">
	<Icon name="right-caret" slot="separator" />
</Breadcrumbs>

<!-- Renders the <h1 id="_top">, the description and the prev/next controls. -->
<ThemeBlackPageTitle />

<style>
	/* astro-breadcrumbs ships unstyled-ish defaults; match Starlight's type scale. */
	:global(.c-breadcrumbs) {
		margin-bottom: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	:global(.c-breadcrumbs__crumbs) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4em;
		padding: 0;
		margin: 0;
		list-style: none;
	}
	:global(.c-breadcrumbs__crumb) {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}
	:global(.c-breadcrumbs__separator) {
		display: inline-flex;
		color: var(--sl-color-gray-4);
	}
	:global(.c-breadcrumbs__crumb a) {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	:global(.c-breadcrumbs__crumb a:hover) {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	:global(.c-breadcrumbs__crumb [aria-current='page']) {
		color: var(--sl-color-gray-2);
	}
</style>
