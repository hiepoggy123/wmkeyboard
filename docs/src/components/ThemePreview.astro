---
/**
 * Theme swatch grid that live-recolours a mock keyboard, drawn to match the
 * real WM Keyboard anatomy: toolbar of round icon buttons, borderless
 * soft-rounded keys with corner hint characters, "◂ English ▸" spacebar and
 * an accent enter key.
 *
 *   <ThemePreview />                      — built-in presets
 *   <ThemePreview themes={[{ name, board, key, text, accent, bar }]} />
 *
 * `board` may be a gradient. Purely illustrative — real theming docs live
 * in /themes/.
 */
interface Theme {
	name: string;
	board: string;
	key: string;
	text: string;
	accent: string;
	bar: string;
}
interface Props {
	themes?: Theme[];
	caption?: string;
}
const DEFAULTS: Theme[] = [
	{ name: 'Midnight', board: 'linear-gradient(180deg,#0e1b33,#0a1224)', key: '#1d2b47', text: '#dbe4f8', accent: '#3b82f6', bar: '#16233c' },
	{ name: 'AMOLED', board: '#000000', key: '#15151a', text: '#e8e8ee', accent: '#4c8df6', bar: '#0a0a0d' },
	{ name: 'Daylight', board: '#e8ebf4', key: '#ffffff', text: '#1d2033', accent: '#5058dd', bar: '#dde1ee' },
	{ name: 'Sunset', board: 'linear-gradient(160deg,#2b1a3d,#4d1d3a)', key: '#3a2450', text: '#ffe9f2', accent: '#ff7aa2', bar: '#331f47' },
	{ name: 'Forest', board: '#12211a', key: '#1e3629', text: '#e3f2e9', accent: '#4fce8d', bar: '#182b21' },
	{ name: 'High contrast', board: '#000000', key: '#101010', text: '#ffffff', accent: '#ffd400', bar: '#000000' },
];
const { themes = DEFAULTS, caption } = Astro.props;
const first = themes[0];

// [label, hint?] per key; mirrors the app's default English layout.
const ROW1: [string, string?][] = [['q'], ['w'], ['e', 'è'], ['r'], ['t'], ['y'], ['u', 'ù'], ['i', 'ì'], ['o', 'ò'], ['p']];
const ROW2: [string, string?][] = [['a', '@'], ['s', '#'], ['d', '$'], ['f'], ['g', '&'], ['h'], ['j'], ['k', '('], ['l', ')']];
const ROW3: [string, string?][] = [['z', '*'], ['x', '"'], ['c', "'"], ['v'], ['b', ';'], ['n', '!'], ['m', '?']];
---

<figure
	class="wm-theme-preview not-content"
	style={`--tp-board:${first.board};--tp-key:${first.key};--tp-text:${first.text};--tp-accent:${first.accent};--tp-bar:${first.bar}`}
>
	<div class="tp-swatches" role="tablist" aria-label="Theme presets">
		{themes.map((t, i) => (
			<button
				type="button"
				role="tab"
				class="tp-swatch"
				aria-selected={i === 0 ? 'true' : 'false'}
				data-board={t.board}
				data-key={t.key}
				data-text={t.text}
				data-accent={t.accent}
				data-bar={t.bar}
			>
				<span class="tp-chip" style={`background:${t.board}`}>
					<span class="tp-chip-key" style={`background:${t.key};border-color:${t.accent}`}></span>
				</span>
				{t.name}
			</button>
		))}
	</div>

	<div class="tp-board" aria-hidden="true">
		<div class="tp-toolbar">
			<span class="tp-tool">
				<svg viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
			</span>
			<span class="tp-tool">
				<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="10" r="1.1" fill="currentColor"/><circle cx="15" cy="10" r="1.1" fill="currentColor"/><path d="M8.5 14.5c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
			</span>
			<span class="tp-tool">
				<svg viewBox="0 0 24 24"><rect x="6" y="5" width="12" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 5V4a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 4v1" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
			</span>
			<span class="tp-tool">
				<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
			</span>
		</div>
		<div class="tp-row">
			{ROW1.map(([c, hint]) => (
				<span class="tp-key">{c}{hint && <i class="tp-hint">{hint}</i>}</span>
			))}
		</div>
		<div class="tp-row tp-row-inset">
			{ROW2.map(([c, hint]) => (
				<span class="tp-key">{c}{hint && <i class="tp-hint">{hint}</i>}</span>
			))}
		</div>
		<div class="tp-row">
			<span class="tp-key tp-mod tp-wide">⇧</span>
			{ROW3.map(([c, hint]) => (
				<span class="tp-key">{c}{hint && <i class="tp-hint">{hint}</i>}</span>
			))}
			<span class="tp-key tp-mod tp-wide">⌫</span>
		</div>
		<div class="tp-row">
			<span class="tp-key tp-mod tp-wide tp-small">?123</span>
			<span class="tp-key">,<i class="tp-hint">!</i></span>
			<span class="tp-key tp-spacebar"><span class="tp-space-label">◂&ensp;English&ensp;▸</span></span>
			<span class="tp-key">.<i class="tp-hint">…</i></span>
			<span class="tp-key tp-enter tp-wide">
				<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 15.5L20 20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
			</span>
		</div>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.wm-theme-preview {
		margin: 1.5rem 0;
	}
	.tp-swatches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	.tp-swatch {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		margin: 0;
		padding: 0.25em 0.7em 0.25em 0.3em;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}
	.tp-swatch[aria-selected='true'] {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.tp-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5em;
		height: 1.5em;
		border-radius: 50%;
		border: 1px solid var(--sl-color-gray-4);
	}
	.tp-chip-key {
		width: 0.6em;
		height: 0.6em;
		border-radius: 2px;
		border: 1px solid;
	}

	.tp-board {
		display: flex;
		flex-direction: column;
		gap: 7px;
		padding: 12px 8px 10px;
		border-radius: 1rem;
		background: var(--tp-board);
		border: 1px solid var(--sl-color-gray-5);
		transition: background 250ms ease;
		max-width: 26rem;
	}
	.tp-toolbar {
		display: flex;
		justify-content: space-around;
		align-items: center;
		padding: 0 0.6rem 0.3rem;
	}
	.tp-tool {
		display: inline-flex;
		width: 1.9rem;
		height: 1.9rem;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--tp-bar);
		color: var(--tp-text);
		opacity: 0.85;
		transition: background 250ms ease, color 250ms ease;
	}
	.tp-tool svg {
		width: 1.05rem;
		height: 1.05rem;
	}
	.tp-row {
		display: flex;
		justify-content: center;
		gap: 6px;
	}
	.tp-row-inset {
		padding: 0 4.5%;
	}
	.tp-key {
		position: relative;
		flex: 1 1 0;
		min-width: 0;
		padding: 0.62em 0;
		border-radius: 0.62em;
		background: var(--tp-key);
		color: var(--tp-text);
		font-size: 0.78rem;
		line-height: 1;
		text-align: center;
		transition: background 250ms ease, color 250ms ease;
	}
	.tp-hint {
		position: absolute;
		top: 3px;
		right: 5px;
		font-size: 0.5rem;
		font-style: normal;
		opacity: 0.55;
	}
	.tp-mod {
		background: color-mix(in srgb, var(--tp-key) 55%, var(--tp-board));
	}
	.tp-wide { flex-grow: 1.55; }
	.tp-small { font-size: 0.62rem; padding-top: 0.78em; padding-bottom: 0.78em; }
	.tp-spacebar {
		flex-grow: 4.2;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.tp-space-label {
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		opacity: 0.55;
	}
	.tp-enter {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--tp-accent);
		color: #fff;
	}
	.tp-enter svg {
		width: 0.95rem;
		height: 0.95rem;
	}
	:global(:root[data-theme='light']) .tp-enter,
	.tp-enter {
		color: color-mix(in srgb, var(--tp-board) 20%, #fff);
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>

<script>
	document.querySelectorAll('.wm-theme-preview').forEach((root) => {
		const el = root as HTMLElement;
		root.querySelectorAll<HTMLButtonElement>('.tp-swatch').forEach((btn) => {
			btn.addEventListener('click', () => {
				root.querySelectorAll('.tp-swatch').forEach((b) => b.setAttribute('aria-selected', 'false'));
				btn.setAttribute('aria-selected', 'true');
				el.style.setProperty('--tp-board', btn.dataset.board ?? '');
				el.style.setProperty('--tp-key', btn.dataset.key ?? '');
				el.style.setProperty('--tp-text', btn.dataset.text ?? '');
				el.style.setProperty('--tp-accent', btn.dataset.accent ?? '');
				el.style.setProperty('--tp-bar', btn.dataset.bar ?? '');
			});
		});
	});
</script>
