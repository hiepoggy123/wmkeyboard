---
/**
 * Theme swatch grid that live-recolours a mock keyboard.
 *
 *   <ThemePreview />                      — built-in presets
 *   <ThemePreview themes={[{ name, board, key, text, accent, bar }]} />
 *
 * Colours are plain CSS values (gradients allowed for `board`). Purely
 * illustrative — real theming docs live in /themes/.
 */
interface Theme {
	name: string;
	board: string;
	key: string;
	text: string;
	accent: string;
	bar: string;
}
interface Props {
	themes?: Theme[];
	caption?: string;
}
const DEFAULTS: Theme[] = [
	{ name: 'Midnight', board: '#17182b', key: '#24263e', text: '#edeefb', accent: '#6c74f6', bar: '#1d1f33' },
	{ name: 'AMOLED', board: '#000000', key: '#111114', text: '#e8e8ee', accent: '#4c8df6', bar: '#0a0a0d' },
	{ name: 'Daylight', board: '#eef0f7', key: '#ffffff', text: '#1d2033', accent: '#5058dd', bar: '#e2e5f0' },
	{ name: 'Sunset', board: 'linear-gradient(150deg,#2b1a3d,#4d1d3a)', key: '#3a2450', text: '#ffe9f2', accent: '#ff7aa2', bar: '#331f47' },
	{ name: 'Forest', board: '#12211a', key: '#1c3328', text: '#e3f2e9', accent: '#4fce8d', bar: '#182b21' },
	{ name: 'High contrast', board: '#000000', key: '#000000', text: '#ffffff', accent: '#ffd400', bar: '#000000' },
];
const { themes = DEFAULTS, caption } = Astro.props;
const first = themes[0];
const KEY_ROWS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];
---

<figure
	class="wm-theme-preview"
	style={`--tp-board:${first.board};--tp-key:${first.key};--tp-text:${first.text};--tp-accent:${first.accent};--tp-bar:${first.bar}`}
>
	<div class="tp-swatches" role="tablist" aria-label="Theme presets">
		{themes.map((t, i) => (
			<button
				type="button"
				role="tab"
				class="tp-swatch"
				aria-selected={i === 0 ? 'true' : 'false'}
				data-board={t.board}
				data-key={t.key}
				data-text={t.text}
				data-accent={t.accent}
				data-bar={t.bar}
			>
				<span class="tp-chip" style={`background:${t.board}`}>
					<span class="tp-chip-key" style={`background:${t.key};border-color:${t.accent}`}></span>
				</span>
				{t.name}
			</button>
		))}
	</div>

	<div class="tp-board" aria-hidden="true">
		<div class="tp-bar">
			<span class="tp-sugg tp-sugg-accent">keyboard</span>
			<span class="tp-sugg">keyboards</span>
			<span class="tp-sugg">key</span>
		</div>
		{KEY_ROWS.map((row, i) => (
			<div class="tp-row">
				{i === 2 && <span class="tp-key tp-wide">⇧</span>}
				{row.split('').map((c) => (
					<span class="tp-key">{c}</span>
				))}
				{i === 2 && <span class="tp-key tp-wide">⌫</span>}
			</div>
		))}
		<div class="tp-row">
			<span class="tp-key tp-wide">?123</span>
			<span class="tp-key">,</span>
			<span class="tp-key tp-spacebar"></span>
			<span class="tp-key">.</span>
			<span class="tp-key tp-wide tp-enter">⏎</span>
		</div>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.wm-theme-preview {
		margin: 1.5rem 0;
	}
	.tp-swatches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	.tp-swatch {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding: 0.25em 0.7em 0.25em 0.3em;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}
	.tp-swatch[aria-selected='true'] {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.tp-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5em;
		height: 1.5em;
		border-radius: 50%;
		border: 1px solid var(--sl-color-gray-4);
	}
	.tp-chip-key {
		width: 0.6em;
		height: 0.6em;
		border-radius: 2px;
		border: 1px solid;
	}
	.tp-board {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 10px;
		border-radius: 0.9rem;
		background: var(--tp-board);
		border: 1px solid var(--sl-color-gray-5);
		transition: background 250ms ease;
		max-width: 26rem;
	}
	.tp-bar {
		display: flex;
		justify-content: center;
		gap: 1.2em;
		padding: 0.3em 0 0.45em;
		border-radius: 0.5em;
		background: var(--tp-bar);
		transition: background 250ms ease;
	}
	.tp-sugg {
		color: var(--tp-text);
		opacity: 0.75;
		font-size: 0.72rem;
		transition: color 250ms ease;
	}
	.tp-sugg-accent {
		color: var(--tp-accent);
		opacity: 1;
		font-weight: 650;
	}
	.tp-row {
		display: flex;
		justify-content: center;
		gap: 5px;
	}
	.tp-key {
		flex: 1 1 0;
		min-width: 0;
		padding: 0.5em 0;
		border-radius: 0.4em;
		background: var(--tp-key);
		color: var(--tp-text);
		font-size: 0.7rem;
		line-height: 1;
		text-align: center;
		transition: background 250ms ease, color 250ms ease;
	}
	.tp-wide {
		flex-grow: 1.6;
	}
	.tp-spacebar {
		flex-grow: 4.5;
	}
	.tp-enter {
		background: var(--tp-accent);
		color: var(--tp-board);
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>

<script>
	document.querySelectorAll('.wm-theme-preview').forEach((root) => {
		const el = root as HTMLElement;
		root.querySelectorAll<HTMLButtonElement>('.tp-swatch').forEach((btn) => {
			btn.addEventListener('click', () => {
				root.querySelectorAll('.tp-swatch').forEach((b) => b.setAttribute('aria-selected', 'false'));
				btn.setAttribute('aria-selected', 'true');
				el.style.setProperty('--tp-board', btn.dataset.board ?? '');
				el.style.setProperty('--tp-key', btn.dataset.key ?? '');
				el.style.setProperty('--tp-text', btn.dataset.text ?? '');
				el.style.setProperty('--tp-accent', btn.dataset.accent ?? '');
				el.style.setProperty('--tp-bar', btn.dataset.bar ?? '');
			});
		});
	});
</script>
